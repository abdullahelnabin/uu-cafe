{
  "name": "Food",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Breakfast",
        "Meals",
        "Snacks",
        "Beverages",
        "Desserts"
      ]
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "image": {
      "type": "string"
    },
    "available": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "category",
    "price"
  ],
"rls": {
  "create": { "user_condition": { "role": "admin" } },
  "read": true,
  "update": { "user_condition": { "role": "admin" } },
  "delete": { "user_condition": { "role": "admin" } }
}
}
