{
  "name": "Cart",
  "type": "object",
  "properties": {
    "foodId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "unitPrice": {
      "type": "number"
    },
    "quantity": {
      "type": "number"
    }
  },
  "required": [
    "foodId",
    "name",
    "unitPrice",
    "quantity"
  ],
"rls": {
  "create": { "user_condition": { "role": "user" } },
  "read": { "created_by_id": "{{user.id}}" },
  "update": { "created_by_id": "{{user.id}}" },
  "delete": { "created_by_id": "{{user.id}}" }
}
}
